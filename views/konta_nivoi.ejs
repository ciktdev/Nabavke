<%
    // ---- Pomoćne vrednosti za prikaz (logika upita ostaje u app.js) ----
    const svg = (d) => '<svg class="ik" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + d + '</svg>';
    const I = {
        download: svg('<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/>'),
        search:   svg('<circle cx="11" cy="11" r="8"/><path d="M21 21l-4.3-4.3"/>')
    };
    const fmt = (n) => Number(n || 0).toLocaleString('sr-RS', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    const duzina = Number(odabranaDuzina) || 7;
    const nivoi = [3, 4, 5, 6, 7, 8];
    if (!nivoi.includes(duzina)) { nivoi.push(duzina); nivoi.sort((a, b) => a - b); }

    const q = (d) => '?duzina=' + d +
        '&prefix=' + encodeURIComponent(odabraniPrefix || '') +
        '&fond=' + encodeURIComponent(odabraniFond || '') +
        '&godina=' + encodeURIComponent(odabranaGodina || '');

    const imaFilter = !!(odabraniPrefix || odabraniFond || odabranaGodina);
    const najvece = podaci.reduce((m, r) => Math.max(m, Math.abs(Number(r.ukupno_utroseno) || 0)), 0);
%><!DOCTYPE html>
<html lang="sr">
<head>
    <%- include('partials/head', { naslov: 'Stanje po kontima – Nabavke' }) %>
</head>
<body class="app">
    <%- include('partials/topbar', { aktivna: 'konta' }) %>

    <main class="container">

        <div class="page-head">
            <div>
                <h1>Potrošnja po nivoima konta</h1>
                <p class="podnaslov">Izaberi koliko cifara konta se grupiše (npr. 3 cifre = grupa 421, 7 cifara = pun konto).</p>
            </div>
            <div class="akcije">
                <a class="btn btn-secondary" href="/izvoz-konta-nivoi-excel<%= q(duzina) %>"><%- I.download %>Izvezi u Excel</a>
            </div>
        </div>

        <div class="toolbar toolbar-nivoi">
            <div class="polje">
                <span>Nivo (broj cifara)</span>
                <div class="segment" role="group" aria-label="Broj cifara konta">
                    <% nivoi.forEach(n => { %>
                        <a href="/konta-nivoi<%= q(n) %>" class="<%= n === duzina ? 'aktivan' : '' %>"<% if (n === duzina) { %> aria-current="true"<% } %>><%= n %></a>
                    <% }) %>
                </div>
            </div>

            <form class="trazi trazi-nivoi" action="/konta-nivoi" method="GET">
                <input type="hidden" name="duzina" value="<%= duzina %>">
                <label class="polje">
                    <span>Prefiks konta</span>
                    <input class="input" type="text" name="prefix" value="<%= odabraniPrefix %>" placeholder="npr. 421" inputmode="numeric" style="width:120px">
                </label>
                <label class="polje">
                    <span>Izvor finansiranja</span>
                    <input class="input" type="text" name="fond" value="<%= odabraniFond %>" placeholder="npr. RFZO" style="width:190px">
                </label>
                <label class="polje">
                    <span>Godina</span>
                    <input class="input input-godina" type="number" name="godina" value="<%= odabranaGodina %>" placeholder="npr. 2025">
                </label>
                <div class="polje-akcije">
                    <button type="submit" class="btn btn-primary"><%- I.search %>Filtriraj</button>
                    <% if (imaFilter) { %><a class="btn btn-ghost" href="/konta-nivoi?duzina=<%= duzina %>">Poništi</a><% } %>
                </div>
            </form>

            <span class="broj-rezultata">Redova: <strong><%= podaci.length %></strong></span>
        </div>

        <div class="karta">
            <table class="tbl tbl-nivoi">
                <thead>
                    <tr>
                        <th>Konto</th>
                        <th>Izvor finansiranja</th>
                        <th>Godina</th>
                        <th class="num">Ukupno utrošeno</th>
                    </tr>
                </thead>
                <tbody>
                <% if (podaci.length === 0) { %>
                    <tr><td colspan="4" class="prazno">Nema podataka za izabrani filter.</td></tr>
                <% } else { %>
                    <% podaci.forEach(row => {
                        const v = Number(row.ukupno_utroseno || 0);
                        const sirina = najvece > 0 ? Math.max(0, Math.min(100, Math.abs(v) / najvece * 100)) : 0;
                    %>
                    <tr>
                        <td class="konto-broj"><strong><%= row.razred %></strong></td>
                        <td><%= row.fond_ime %></td>
                        <td><span class="godina-chip"><%= row.fond_godina %></span></td>
                        <td class="num celija-iznos">
                            <span class="iznos-traka" style="width: <%= sirina %>%"></span>
                            <span class="iznos-vr"><%= fmt(v) %> <small>RSD</small></span>
                        </td>
                    </tr>
                    <% }); %>
                <% } %>
                </tbody>
            </table>
        </div>
    </main>
</body>
</html>
